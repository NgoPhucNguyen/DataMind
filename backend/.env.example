# Local Development
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/datamind_local
FRONTEND_URLS=http://localhost:3000
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=your-model
GEMINI_MOCK=0
GEMINI_MOCK_ERROR=
GROQ_API_KEY=
GROQ_MODEL=
REDIS_URL=redis://localhost:6379
SECRET_KEY=your-secret-key-change-in-production
GOOGLE_CLIENT_ID=
# Supabase Storage (dùng để lưu Clean Dataset — Bỏ trống khi dev local thì dùng dev fallback URL)
# Lấy từ: Supabase Dashboard → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Production (set in Render dashboard)
# DATABASE_URL=postgresql://[user]:[pass]@[project].supabase.co:5432/postgres
# REDIS_URL=https://[token]@[region].upstash.io
# GEMINI_API_KEY=your-production-gemini-key
# SUPABASE_URL=https://[project-ref].supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

SEPAY_WEBHOOK_SECRET=your_secret_here
SEPAY_ALLOWED_IPS=127.0.0.1,::1
